{
  "name": "@knowttl/mg-axi",
  "version": "0.1.1",
  "description": "Agent-facing Microsoft Graph CLI, read-only by default",
  "type": "module",
  "bin": {
    "mg-axi": "dist/bin/mg-axi.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/mg-axi.git"
  },
  "files": [
    "dist",
    "inventory/schema.json",
    "inventory/operations.json",
    "skills/mg-axi",
    "docs/coverage.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "docs:generate": "node tools/generate-docs.mjs",
    "docs:check": "node tools/generate-docs.mjs --check"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@toon-format/toon": "^2.3.0",
    "axi-sdk-js": "^0.1.13",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
