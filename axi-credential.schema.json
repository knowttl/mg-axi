{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mg-axi credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "tenantId", "clientId"],
  "properties": {
    "mode": { "enum": ["delegated", "application"] },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "clientId": { "$ref": "#/$defs/uuid" },
    "cloud": { "const": "commercial", "default": "commercial" },
    "enabledPacks": { "type": "array", "items": { "enum": ["entra", "security", "mail"] }, "uniqueItems": true, "default": ["entra"] },
    "preview": { "type": "boolean", "default": false },
    "sensitiveAreas": { "type": "array", "maxItems": 0, "default": [] },
    "allowDeviceCode": { "type": "boolean", "default": false },
    "auth": { "enum": ["certificate", "client-secret", "federated"] },
    "thumbprintSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "privateKey": { "$ref": "#/$defs/externalSecret", "x-secret": true },
    "clientSecret": { "$ref": "#/$defs/externalSecret", "x-secret": true },
    "token": { "$ref": "#/$defs/secret", "x-secret": true },
    "writes": {
      "type": "object", "additionalProperties": false, "required": ["allowWrites", "operations"],
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "mode": { "const": "delegated" } },
      "not": { "anyOf": [{ "required": ["auth"] }, { "required": ["privateKey"] }, { "required": ["clientSecret"] }, { "required": ["thumbprintSha256"] }] }
    },
    {
      "required": ["auth", "thumbprintSha256"],
      "properties": { "mode": { "const": "application" }, "auth": { "const": "certificate" }, "allowDeviceCode": { "const": false } },
      "not": { "anyOf": [{ "required": ["token"] }, { "required": ["clientSecret"] }] }
    },
    {
      "required": ["auth"],
      "properties": { "mode": { "const": "application" }, "auth": { "const": "client-secret" }, "allowDeviceCode": { "const": false } },
      "not": { "anyOf": [{ "required": ["token"] }, { "required": ["privateKey"] }, { "required": ["thumbprintSha256"] }] }
    },
    {
      "required": ["auth"],
      "properties": { "mode": { "const": "application" }, "auth": { "const": "federated" }, "token": { "$ref": "#/$defs/externalSecret" }, "allowDeviceCode": { "const": false } },
      "not": { "anyOf": [{ "required": ["privateKey"] }, { "required": ["clientSecret"] }, { "required": ["thumbprintSha256"] }] }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "externalSecret": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } }
      ]
    },
    "secret": {
      "oneOf": [
        { "$ref": "#/$defs/externalSecret" },
        { "type": "object", "additionalProperties": false, "required": ["stored"], "properties": { "stored": { "const": true } } }
      ]
    }
  }
}
