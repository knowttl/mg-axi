{
  "name": "@knowttl/mg-axi",
  "version": "0.1.15",
  "license": "MIT",
  "description": "Agent-facing Microsoft Graph CLI, read-only by default",
  "type": "module",
  "bin": {
    "mg-axi": "dist/bin/mg-axi.js",
    "mg-axi-hook": "dist/bin/mg-axi-hook.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/mg-axi.git"
  },
  "files": [
    "dist",
    "inventory/schema.json",
    "inventory/runtime.json",
    "skills/mg-axi",
    "docs/coverage.md",
    "README.md",
    "axi-credential.schema.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "node tools/generate-runtime-index.mjs && tsc -p tsconfig.json",
    "test": "node tools/isolated-home.mjs node --test --test-concurrency=4 test/*.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "docs:generate": "node tools/generate-runtime-index.mjs && node tools/generate-docs.mjs",
    "docs:check": "node tools/generate-runtime-index.mjs --check && node tools/generate-docs.mjs --check"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@kusto/language-service-next": "^12.4.1",
    "@toon-format/toon": "^2.3.0",
    "axi-sdk-js": "^0.1.13",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
