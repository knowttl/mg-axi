{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV-01 Entra discovery inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "revision", "checkedOn", "sources", "operations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"const": "microsoftgraph/msgraph-metadata"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "checkedOn": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "path", "sha256", "bytes", "discoveredOperations", "excludedByRoot"],
        "properties": {
          "version": {"$ref": "#/$defs/version"},
          "path": {"type": "string", "pattern": "^openapi/(v1\\.0|beta)/openapi\\.yaml$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "discoveredOperations": {"type": "integer", "minimum": 1},
          "excludedByRoot": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "version": {"enum": ["v1.0", "beta"]},
    "text": {"type": "string", "minLength": 1},
    "source": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "sources"],
      "properties": {
        "status": {"const": "not-reviewed"},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operationId", "version", "method", "path", "cloud", "tenantType", "documentation", "authModes", "permissions", "roles", "licences", "cloudAvailability", "disposition", "reason", "owningSlice"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "operationId": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/version"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
        "path": {"type": "string", "pattern": "^/"},
        "cloud": {"const": "commercial"},
        "tenantType": {"const": "workforce"},
        "documentation": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "authModes": {
          "type": "object", "additionalProperties": false,
          "required": ["delegated", "application"],
          "properties": {"delegated": {"$ref": "#/$defs/evidence"}, "application": {"$ref": "#/$defs/evidence"}}
        },
        "permissions": {"$ref": "#/$defs/evidence"},
        "roles": {"$ref": "#/$defs/evidence"},
        "licences": {"$ref": "#/$defs/evidence"},
        "cloudAvailability": {"$ref": "#/$defs/evidence"},
        "disposition": {"enum": ["named-command", "reviewed-raw-read", "scheduled", "intentionally-blocked", "deprecated", "unavailable"]},
        "reason": {"$ref": "#/$defs/text"},
        "owningSlice": {"enum": ["READ-01", "READ-02", "READ-03", "READ-04", "READ-05", "READ-06", "READ-07", "READ-08", "READ-09", "READ-10", "EXT-01", "EXT-02", "EXT-03", "EXT-04", "WRITE-01", "WRITE-02", "WRITE-03", "WRITE-04", "WRITE-05", "WRITE-N"]}
      }
    }
  }
}
